# Names of the secrets the system needs. NEVER put real values in this file or in Git.
# Set the real values as RunPod Secrets (or in a local .env that is git-ignored).

# --- Mode (defaults are the safe ones) ---
ROLE=all
TRADING_MODE=paper
BROKER_ENV=demo
LIVE_TRADING_ENABLED=false
# Owner-directed Tai demo experiment; remains disabled until an explicit redeploy.
TAI_DEMO_EXPERIMENT=false
TAI_DEMO_BASE_LOT=0.1
# Demo balance when the experiment starts; lot = 0.1 x balance / start balance (required)
TAI_DEMO_START_BALANCE=0
APPROVAL_MODE=false

# --- Capital.com ---
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

# --- Hosted AI model (provider to be chosen) ---
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Storage ---
DATABASE_URL=
REDIS_URL=

# --- RunPod ---
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=
# Required only when scaling.enabled is explicitly enabled on the core pod.
RUNPOD_WORKER_IMAGE=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_IDS=
OWNER_TOTP_SECRET=
CONTROL_API_TOKEN=

# --- Email reports ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# --- Backups ---
GITHUB_TOKEN=
HF_TOKEN=

# --- Research data ---
SEARCH_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
